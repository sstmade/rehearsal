# Copy to .env (git-ignored). Everything is optional: with no key the app runs offline ($0).
# Meta Model API key from https://dev.meta.ai. Live Muse Spark / SAM 3.1 calls spend money.
MODEL_API_KEY=
# Any non-empty value forces the rule-based OfflineAgent even if a key is set.
# REHEARSAL_OFFLINE=1
# Hard spend cap in USD for budget/ledger.jsonl (default 15).
# REHEARSAL_BUDGET_CAP=15
# Web server bind address/port (default 127.0.0.1:8765).
# REHEARSAL_HOST=127.0.0.1
# REHEARSAL_PORT=8765
# Stress-test process pool size (default: all cores).
# REHEARSAL_WORKERS=
