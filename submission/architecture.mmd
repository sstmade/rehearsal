%% Rehearsal architecture. Render: https://mermaid.live or GitHub markdown.
%% Blue = Meta models (proposals). Green = physics/code (decisions).
flowchart LR
  subgraph IN[Input]
    P[Phone photo<br/>+ A4 sheet]
    I[Instruction<br/>put the mug in the bowl,<br/>stack the books]
  end

  subgraph PERC[Perception · rehearsal/perception.py]
    MS1[Muse Spark 1.3<br/>list objects, noun phrase,<br/>size / mass / friction ranges]
    SAM[SAM 3.1<br/>concept prompt per noun<br/>→ point-prompt fallback]
    H[A4 homography<br/>pixels → table metres]
  end

  SC[(Scene JSON<br/>objects + uncertainty σ)]

  subgraph SIM[Physics · MuJoCo + Franka Panda]
    BLD[scene.py<br/>MjSpec + suction]
    EX[executor.py / sim.py<br/>IK, transport, contact log]
    PR[predicates.py<br/>inside · on · stacked ·<br/>upright · stable · undisturbed]
  end

  subgraph AGENT[Agent · rehearsal/agents.py]
    MS2[Muse Spark<br/>compile goals → predicates]
    MS3[Muse Spark<br/>plan transport actions]
    MS4[Muse Spark<br/>read sim log → diagnose → revise]
  end

  subgraph ROB[Robustness · rehearse.py]
    ST[Stress test<br/>40 universes, common random numbers<br/>σ=1.2 cm, friction ×0.6–1.4, mass ×0.7–1.3]
    AP[Active perception<br/>value of re-observing each object<br/>σ 1.2 → 0.4 cm]
  end

  R[Report + 3D replay<br/>verified · estimated · assumed]

  P --> MS1 --> SAM --> H --> SC
  SC --> BLD --> EX
  I --> MS2 --> MS3 --> EX
  EX --> PR
  PR -- all goals pass --> ST
  PR -- failed predicates + contacts + IK errors --> MS4 --> EX
  ST --> AP --> R
  AP -. look again at the mug .-> P

  classDef meta fill:#dbeafe,stroke:#1d4ed8,color:#0b1b3f;
  classDef phys fill:#dcfce7,stroke:#15803d,color:#052e16;
  class MS1,SAM,MS2,MS3,MS4 meta;
  class BLD,EX,PR,ST,AP,H phys;
