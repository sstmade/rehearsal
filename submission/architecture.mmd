%% Rehearsal architecture (post-pivot). Render: https://mermaid.live or GitHub markdown.
%% Blue = Meta models (proposals). Green = code / physics (decisions). Grey = real-world check.
flowchart LR
  subgraph IN[Input]
    P[Phone photo<br/>+ A4 sheet]
    I[Instruction<br/>make some room on the desk]
  end

  subgraph PERC[Perception · rehearsal/perception.py]
    MS1[Muse Spark 1.3<br/>list objects, noun phrase,<br/>size / mass / friction ranges]
    SAM[SAM 3.1<br/>concept prompt per noun<br/>→ point-prompt fallback]
    H[A4 homography<br/>pixels → table metres]
  end

  SC[(Scene JSON<br/>objects + uncertainty σ)]

  subgraph INTENT[1 · Intent]
    MS2[Muse Spark 1.3<br/>goals as predicates<br/>+ assumptions<br/>or clarify / refuse]
    GATE{Intent gate, no LLM<br/>empty? unknown object?<br/>already true? contradictory?}
    USER[User confirms<br/>assumptions]
    IMP[with_implicit_goals<br/>undisturbed for every object<br/>the goals do not move]
  end

  subgraph GEO[2 · Geometry · rehearsal/search_planner.py]
    HINT[Muse Spark plan hint<br/>order + first guess<br/>optional]
    SRCH[Search, no LLM<br/>orders × carry heights × detours<br/>IK + collision dry run]
  end

  subgraph PHYS[3 · Physics · MuJoCo + Franka Panda]
    EX[executor.py / sim.py<br/>IK, transport, contact log]
    PR[predicates.py<br/>on · inside · stacked · upright ·<br/>stable · undisturbed · near · clear]
    ST[Stress gate<br/>20 selection seeds<br/>friction ×0.6–1.4, mass ×0.7–1.3, σ]
  end

  subgraph REAL[4 · Reality · rehearsal/replay.py, reality.py]
    D[DROID episodes<br/>real Franka, CC BY 4.0]
    RP[Replay recorded joints<br/>in a twin built from frame 1]
    SV[SAM 3.1 video<br/>where objects really ended up]
  end

  R[Report<br/>checked · estimated · assumed]

  P --> MS1 --> SAM --> H --> SC
  I --> MS2 --> GATE
  GATE -- ask / refuse --> USER
  GATE -- ok --> IMP --> SRCH
  USER -- confirmed --> IMP
  SC --> SRCH
  HINT --> SRCH
  SRCH --> EX --> PR
  PR -- fail: prune, try next --> SRCH
  PR -- pass --> ST
  ST -- below 90%: keep searching --> SRCH
  ST -- best plan --> R
  D --> RP --> EX
  D --> SV
  SV -. compare final positions .-> PR

  classDef meta fill:#dbeafe,stroke:#1d4ed8,color:#0b1b3f;
  classDef phys fill:#dcfce7,stroke:#15803d,color:#052e16;
  classDef real fill:#f1f5f9,stroke:#475569,color:#0f172a;
  class MS1,SAM,MS2,HINT,SV meta;
  class H,GATE,IMP,SRCH,EX,PR,ST,RP phys;
  class D real;
